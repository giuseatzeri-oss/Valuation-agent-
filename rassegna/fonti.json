{
  "_nota": "Query Google News RSS per sezione. 'site:' = testate prioritarie individuate nel catalogo MLOL FEEM (research/mlol-feem). when:1d = ultime 24 ore.",
  "lingua_default": {"hl": "it", "gl": "IT", "ceid": "IT:it"},
  "sezioni": [
    {"id": "mercati_italia", "titolo": "Mercati e finanza in Italia", "query": [
      "site:milanofinanza.it when:1d",
      "site:ilsole24ore.com finanza when:1d",
      "site:italiaoggi.it when:1d",
      "site:corriere.it/economia when:1d",
      "Borsa Milano Ftse Mib when:1d"]},
    {"id": "private_equity_ma", "titolo": "Private equity e M&A", "query": [
      "private equity Italia when:1d",
      "fondo private equity acquisizione when:1d",
      "M&A Italia operazione advisor when:1d",
      "private equity deal Europe when:1d|en"]},
    {"id": "real_estate", "titolo": "Real estate", "query": [
      "real estate investimenti Italia when:1d",
      "immobiliare fondo SGR when:1d",
      "mercato immobiliare commerciale uffici logistica when:1d",
      "European real estate investment when:1d|en"]},
    {"id": "hospitality", "titolo": "Hospitality e turismo", "query": [
      "hotel investimenti Italia when:1d",
      "hospitality alberghi acquisizione when:1d",
      "site:ttgitalia.com when:1d",
      "site:italiaatavola.net when:1d",
      "hotel investment Europe when:1d|en"]},
    {"id": "macro_mondo", "titolo": "Macro e mercati internazionali", "query": [
      "BCE tassi when:1d",
      "Fed Wall Street when:1d|en",
      "site:wsj.com markets when:1d|en",
      "site:economist.com when:2d|en",
      "site:barrons.com when:1d|en"]}
  ]
}
